DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only-change-before-hosting
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# ors for live routes; recorded for the five sourced offline review routes
ROUTING_PROVIDER=recorded
ORS_API_KEY=
ORS_API_BASE_URL=https://api.heigit.org/openrouteservice
ORS_GEOCODING_BASE_URL=https://api.heigit.org/pelias/v1
ROUTE_CACHE_TTL_SECONDS=86400
GEOCODE_CACHE_TTL_SECONDS=2592000
OPTIMIZATION_CACHE_TTL_SECONDS=3600
CORRIDOR_MILES=5
# Production only: set DEBUG=false, a private random secret and durable Postgres.
# DATABASE_URL=postgresql://... (pooled application URL, SSL required)
# DATABASE_URL_UNPOOLED=postgresql://... (direct migration URL)
# Render provides RENDER_EXTERNAL_HOSTNAME; other hosts need explicit allowed hosts.
